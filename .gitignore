# Credenciales — nunca al repositorio
.env
.env.*
*.key
*.pem

# Datos y artefactos generados
**/warehouse/
**/predicciones/
**/reports/
**/cache_csv/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.parquet
*.jsonl
__pycache__/
*.pyc

# El libro de tickets SÍ va al repositorio: es el historial que valida el
# sistema y no puede vivir en una caché de CI que caduca a los 7 días.
!papel/libro/
!papel/libro/*.jsonl

# Sitio e imágenes generadas (las produce el workflow)
_sitio/
**/tickets_png/

# Datasets del crawler (198 MB)
crawler/dataset*.jsonl
crawler/*.sqlite
